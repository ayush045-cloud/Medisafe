{
  "expo": {
    "name": "Medisafe",
    "slug": "medisafe-android",
    "scheme": "medisafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", {
        "icon": "./assets/notification-icon.png",
        "color": "#167C68",
        "defaultChannel": "medication-reminders"
      }]
    ],
    "android": {
      "package": "com.ayush045.medisafe",
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM", "RECEIVE_BOOT_COMPLETED"]
    },
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID" }
    }
  }
}